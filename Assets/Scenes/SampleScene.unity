  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c940330ae469fc408773dd0616d4e12, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  displayName: Steve
  role: "M\xFAsico"
  options: 00000000
  interactRange: 2.2
  headHeight: 1.1904019
  lines:
  - "\xBFOtra vez esa luz azul en la monta\xF1a? Mientras suene esta fogata, aqu\xED
    nadie se congela."
  - "Antes tocaba para cien ping\xFCinos en la plaza. Ahora prefiero el bosque: los
    pinos no se asustan."
  - "Si subes al Frostspire, c\xE1ntale algo al viento. Dicen que el hielo escucha."
